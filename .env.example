# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
# System app model — lightweight, app-owned model for internal tasks
# (session-title generation, future summaries). OpenAI-compatible endpoint.
# Base URL is the API root (the SDK appends /chat/completions).
SUMO_SYSTEM_BASE_URL=https://openrouter.ai/api/v1
SUMO_SYSTEM_API_KEY=your-openrouter-api-key-here
SUMO_SYSTEM_MODEL=google/gemma-4-26b-a4b-it:free

# RAG cloud-fallback embedder. Reuses the SUMO_SYSTEM_API_KEY above — no
# separate credential. This is the model id hit on the /embeddings route
# when (a) the user has toggled "Allow cloud as build-time fallback" in
# Settings → Memory AND (b) local ONNX is unavailable. Leave unset to use
# the default (the base all-MiniLM-L6-v2, 384-dim — same family as the
# local code-tuned fine-tune, but a different embedding space, so the two
# are bound per-index and never mixed).
SUMO_RAG_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
