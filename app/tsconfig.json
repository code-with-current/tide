{
  "extends": "../.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "types": ["bun"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "electrobun/main": ["../.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["../.hutch/devkit/api/browser/index.ts"]
    }
  },
  "include": ["**/*", "../shared"],
  "files": ["core/knowledge/fetchers/html-to-text.d.ts"],
  "exclude": ["node_modules", "dist", "build", "core"]
}
