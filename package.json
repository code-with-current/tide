{
  "name": "tide",
  "private": true,
  "version": "0.4.0",
  "packageManager": "bun@1.4.0",
  "description": "Tide \u2014 Code with the current.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node build/promptMarkdownUtils.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "app:dev": "tauri dev",
    "preapp:build": "node build/sync-version.mjs",
    "app:build": "tauri build --no-sign",
    "build:mac:arm64": "tauri build --no-sign --target aarch64-apple-darwin",
    "build:mac:x64": "tauri build --no-sign --target x86_64-apple-darwin",
    "build:win:x64": "tauri build --no-sign",
    "build:win:arm64": "tauri build --no-sign --target aarch64-pc-windows-msvc",
    "build:linux": "tauri build --no-sign --bundles appimage,deb,rpm"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "@tauri-apps/api": "^2.11.1",
    "beautiful-mermaid": "^1.1.3",
    "dompurify": "^3.4.13",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "morphdom": "^2.7.8",
    "remend": "^1.3.0",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.71.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-material-icon-theme": "^1.2.0",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "patchedDependencies": {
    "@tanstack/virtual-core@3.17.7": "patches/@tanstack__virtual-core@3.17.7.patch"
  }
}
